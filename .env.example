#-----------------------Backend Config------------------------------#
# Koneksi ke container database PostgreSQL
DATABASE_URL=postgresql://postgres:testpass@hoppscotch-db:5432/hoppscotch

# 1. Kunci enkripsi 32 karakter unik acak
DATA_ENCRYPTION_KEY=c928ab90e86ba63f3ff923c2df9d22b1

# 2. Whitelist origin domain publik dan localhost
WHITELISTED_ORIGINS=https://dev.apsupports.com,http://localhost:3170,http://localhost:3000,http://localhost:3100,app://localhost_3200,app://hoppscotch

# Optional: Default proxy URL untuk bypass CORS
PROXY_APP_URL="https://proxy.hoppscotch.io"

# 3. Wajib 'true' karena berada di belakang Reverse Proxy (Traefik/Nginx)
TRUST_PROXY=true

#-----------------------Frontend Config------------------------------#

# Base URLs
VITE_BASE_URL=https://dev.apsupports.com
VITE_SHORTCODE_BASE_URL=https://dev.apsupports.com
VITE_ADMIN_URL=https://dev.apsupports.com/admin

# Backend URLs
VITE_BACKEND_GQL_URL=https://dev.apsupports.com/backend/graphql
VITE_BACKEND_WS_URL=wss://dev.apsupports.com/backend/graphql
VITE_BACKEND_API_URL=https://dev.apsupports.com/backend/v1

VITE_PROXYSCOTCH_ACCESS_TOKEN=

# 6. Wajib 'true' karena diakses lewat subpath /hoppscotch
ENABLE_SUBPATH_BASED_ACCESS=true