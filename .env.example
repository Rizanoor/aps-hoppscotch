# 1. Kunci enkripsi 32 karakter (wajib unik dan acak)
DATA_ENCRYPTION_KEY=c928ab90e86ba63f3ff923c2df9d22b1

# 2. Tambahkan origin domain publik ke whitelist
WHITELISTED_ORIGINS=https://dev.apsupports.com,http://localhost:3170,http://localhost:3000,http://localhost:3100,app://localhost_3200,app://hoppscotch

# 3. Aktifkan trust proxy karena di belakang Traefik
TRUST_PROXY=true

# 4. Base URLs diarahkan ke subpath domain publik
VITE_BASE_URL=https://dev.apsupports.com/hoppscotch
VITE_SHORTCODE_BASE_URL=https://dev.apsupports.com/hoppscotch
VITE_ADMIN_URL=https://dev.apsupports.com/hoppscotch/admin

# 5. Backend URLs diarahkan ke subpath /backend dan WebSocket wss://
VITE_BACKEND_GQL_URL=https://dev.apsupports.com/hoppscotch/backend/graphql
VITE_BACKEND_WS_URL=wss://dev.apsupports.com/hoppscotch/backend/graphql
VITE_BACKEND_API_URL=https://dev.apsupports.com/hoppscotch/backend/v1

# 6. Wajib aktifkan mode subpath
ENABLE_SUBPATH_BASED_ACCESS=true